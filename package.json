{
  "name": "easy-book",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-library.mjs",
    "dev": "npm run sync && vite --host 0.0.0.0",
    "build": "npm run sync && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run build && node scripts/serve.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
